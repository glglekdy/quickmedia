// 다운로드 화면: 다운로드 목록. 링크 칸은 아래에 떠 있다(composer.slint).
import { Theme } from "theme.slint";
import { Btn, Bar, ScrollArea } from "widgets.slint";
import { Download, CardView } from "download_state.slint";

// 다운로드 한 건. 사이트 · 제목 · 상태 · 진행률.
component Card inherits Rectangle {
    in property <CardView> card;
    callback open();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 10px;
    height: layout.min-height;

    layout := VerticalLayout {
        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            height: 16px;
            if card.has-icon: Image {
                width: 16px; height: 16px;
                source: card.icon;
            }
            if !card.has-icon: Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                background: Theme.accent;
                Text {
                    text: card.letter;
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: card.site;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                horizontal-stretch: 1;
                text: card.title;
                color: Theme.text;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            // 숫자 자릿수가 바뀌어도 옆 글자가 흔들리지 않게 폭 고정
            if card.percent-text != "": Text {
                width: 40px;
                text: card.percent-text;
                color: Theme.percent;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if card.can-open: Btn {
                kind: "ghost";
                text: "열기";
                clicked => { root.open(); }
            }
        }
        if card.show-bar: Bar {
            value: card.progress;
        }
        Text {
            text: card.status;
            color: card.tone == "error" ? Theme.danger : card.tone == "done" ? Theme.success : Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }
}

export component DownloadPage inherits Rectangle {
    VerticalLayout {
        // 목록 머리
        HorizontalLayout {
            padding-left: 28px; padding-right: 28px; padding-top: 18px; padding-bottom: 8px;
            Text {
                text: "다운로드 목록";
                color: Theme.heading;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if Download.cards.length > 0: Btn { kind: "ghost"; text: "끝난 항목 지우기"; clicked => { Download.clear-finished(); } }
        }

        // 목록. 아래에 떠 있는 링크 칸 밑으로 지나가며 스크롤된다.
        ScrollArea {
            content-height: list.min-height;
            if Download.cards.length == 0: VerticalLayout {
                y: (parent.height - 150px) / 2 - 40px; height: 150px; width: parent.width;
                spacing: 10px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px; height: 56px;
                        border-radius: 28px;
                        background: Theme.card-bg;
                        Image {
                            x: 16px; y: 16px; width: 24px; height: 24px;
                            source: @image-url("../assets/download.svg");
                            colorize: Theme.muted;
                        }
                    }
                }
                Text {
                    text: "아직 받은 영상이 없어요";
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: "아래 칸에 링크를 붙여넣고 Enter 를 누르세요";
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
            list := VerticalLayout {
                padding-left: 28px; padding-right: 28px; padding-bottom: 130px;
                spacing: 8px;
                alignment: start;
                for card in Download.cards: Card {
                    card: card;
                    open => { Download.reveal(card.id); }
                }
            }
        }
    }
}
