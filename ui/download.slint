// 다운로드 화면: 링크 입력 · 형식 고르기 · 프리셋 · 세부 옵션 · 다운로드 목록.
import { Theme } from "theme.slint";
import { Btn, LineInput, Bar, ScrollArea } from "widgets.slint";
import { Download, CardView } from "download_state.slint";
import { OptionsPanel } from "options_panel.slint";

component SegButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: 26px;
    min-width: label.min-width + 28px;
    horizontal-stretch: 0;
    border-radius: 4px;
    background: checked ? Theme.btn-hover : transparent;
    label := Text {
        text: root.text;
        color: root.checked || touch.has-hover ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 저장해 둔 프리셋을 고르고, 지금 세부 옵션을 이름 붙여 저장하는 메뉴.
component PresetMenu inherits Rectangle {
    property <bool> chosen: Download.user-preset >= 0 && Download.user-preset < Download.user-presets.length;
    height: button.height;
    min-width: button.min-width;
    horizontal-stretch: 0;

    button := Btn {
        kind: "ghost";
        text: root.chosen ? "프리셋 · " + Download.user-presets[Download.user-preset] : "프리셋";
        has-icon: true;
        icon: @image-url("../assets/arrow-down.svg");
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: 260px;
        // 이름 칸을 눌러도 닫히지 않게
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 8px;
            VerticalLayout {
                padding: 6px;
                spacing: 2px;
                if Download.user-presets.length == 0: Text {
                    height: 30px;
                    text: "  저장한 프리셋이 없어요";
                    color: Theme.muted;
                    font-size: 12px;
                    vertical-alignment: center;
                }
                for name[i] in Download.user-presets: Rectangle {
                    height: 30px;
                    border-radius: 4px;
                    background: pick.has-hover || i == Download.user-preset ? Theme.btn-hover : transparent;
                    pick := TouchArea {
                        clicked => {
                            Download.apply-user-preset(i);
                            popup.close();
                        }
                    }
                    Text {
                        x: 8px; width: parent.width - 44px;
                        text: name;
                        color: Theme.text;
                        font-weight: i == Download.user-preset ? 600 : 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        x: parent.width - 28px; y: 3px;
                        width: 24px; height: 24px;
                        border-radius: 4px;
                        background: remove.has-hover ? Theme.btn-pressed : transparent;
                        Text {
                            text: "×";
                            color: remove.has-hover ? Theme.danger : Theme.muted;
                            font-size: 15px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        remove := TouchArea {
                            clicked => { Download.delete-user-preset(i); }
                        }
                    }
                }
                Rectangle {
                    height: 9px;
                    Rectangle { y: 4px; height: 1px; background: Theme.border; }
                }
                Text {
                    text: "  지금 세부 옵션을 프리셋으로 저장";
                    color: Theme.muted;
                    font-size: 12px;
                    height: 20px;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 6px;
                    LineInput {
                        height: 30px;
                        text <=> Download.preset-name;
                        placeholder: "이름";
                        invalid: Download.preset-error != "";
                        accepted => { Download.save-preset(); }
                    }
                    Btn { text: "저장"; clicked => { Download.save-preset(); } }
                }
                if Download.preset-error != "": Text {
                    text: "  " + Download.preset-error;
                    color: Theme.danger;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }
}

// 다운로드 한 건. 사이트 · 제목 · 상태 · 진행률.
component Card inherits Rectangle {
    in property <CardView> card;
    callback open();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 10px;
    height: layout.min-height;

    layout := VerticalLayout {
        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            height: 16px;
            if card.has-icon: Image {
                width: 16px; height: 16px;
                source: card.icon;
            }
            if !card.has-icon: Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                background: Theme.accent;
                Text {
                    text: card.letter;
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: card.site;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                horizontal-stretch: 1;
                text: card.title;
                color: Theme.text;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            // 숫자 자릿수가 바뀌어도 옆 글자가 흔들리지 않게 폭 고정
            if card.percent-text != "": Text {
                width: 40px;
                text: card.percent-text;
                color: Theme.percent;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if card.can-open: Btn {
                kind: "ghost";
                text: "열기";
                clicked => { root.open(); }
            }
        }
        if card.show-bar: Bar {
            value: card.progress;
        }
        Text {
            text: card.status;
            color: card.tone == "error" ? Theme.danger : card.tone == "done" ? Theme.success : Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }
}

export component DownloadPage inherits VerticalLayout {
    public function focus-url() { url.focus-input(); }

    // 입력
    VerticalLayout {
        padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 6px;
            url := LineInput {
                text <=> Download.url;
                placeholder: Download.url-placeholder;
                accepted => { Download.add(); }
            }
            VerticalLayout {
                alignment: center;
                Btn { text: "붙여넣기"; clicked => { Download.paste(); } }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Rectangle {
                horizontal-stretch: 0;
                height: 32px;
                border-radius: 6px;
                background: Theme.input-bg;
                HorizontalLayout {
                    padding: 3px;
                    spacing: 2px;
                    SegButton { text: "최고 화질"; checked: Download.preset == "best"; clicked => { Download.preset-clicked("best"); } }
                    SegButton { text: "720p"; checked: Download.preset == "720p"; clicked => { Download.preset-clicked("720p"); } }
                    SegButton { text: "MP3 음원"; checked: Download.preset == "mp3"; clicked => { Download.preset-clicked("mp3"); } }
                }
            }
            VerticalLayout {
                alignment: center;
                PresetMenu { }
            }
            VerticalLayout {
                alignment: center;
                Btn {
                    kind: "ghost";
                    text: Download.more-text;
                    has-icon: true;
                    icon: Download.panel-open ? @image-url("../assets/arrow-up.svg") : @image-url("../assets/arrow-down.svg");
                    clicked => { Download.toggle-panel(); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Btn { kind: "primary"; text: "다운로드"; clicked => { Download.add(); } }
            }
        }
        if Download.error != "": Text {
            text: Download.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
        if Download.panel-open: OptionsPanel { }
    }

    // 목록 머리
    HorizontalLayout {
        padding-left: 28px; padding-right: 28px; padding-top: 4px; padding-bottom: 6px;
        Text {
            text: "다운로드 목록";
            color: Theme.muted;
            font-size: 12px;
            font-weight: 500;
            vertical-alignment: center;
        }
        Rectangle { horizontal-stretch: 1; }
        Btn { kind: "ghost"; text: "끝난 항목 지우기"; clicked => { Download.clear-finished(); } }
    }

    // 목록
    ScrollArea {
        content-height: list.min-height;
        if Download.cards.length == 0: Text {
            y: 32px; height: 24px; width: parent.width;
            text: "아직 받은 영상이 없어요";
            color: Theme.muted;
            font-size: 14px;
            horizontal-alignment: center;
        }
        list := VerticalLayout {
            padding-left: 28px; padding-right: 28px; padding-bottom: 16px;
            spacing: 8px;
            alignment: start;
            for card in Download.cards: Card {
                card: card;
                open => { Download.reveal(card.id); }
            }
        }
    }
}
