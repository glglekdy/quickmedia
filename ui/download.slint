// 다운로드 화면: 다운로드 목록. 링크 칸은 아래에 떠 있다(composer.slint).
import { Theme, Lang } from "theme.slint";
import { Btn, Bar, ScrollArea } from "widgets.slint";
import { Download, CardView } from "download_state.slint";

// 다운로드 한 건. 사이트 · 제목 · 상태 · 진행률.
component Card inherits Rectangle {
    in property <CardView> card;
    callback open();

    background: Theme.card-bg;
    border-width: 1px;
    border-color: Theme.border;
    border-radius: 10px;
    // 목록에서 빠질 때는 접히며 흐려진다
    property <float> stay: self.card.leaving ? 0 : 1;
    animate stay { duration: 220ms; easing: ease-out; }
    height: layout.min-height * self.stay;
    clip: true;

    // 새 카드는 날아온 동그라미가 자리를 잡을 즈음부터 서서히 보인다
    property <bool> entering;
    property <duration> born;
    init => {
        if self.card.fresh {
            self.born = animation-tick();
            self.entering = true;
        }
    }
    opacity: self.stay * (self.entering ? clamp((animation-tick() - self.born - 300ms) / 240ms, 0, 1) : 1);
    Timer {
        interval: 560ms;
        running: root.entering;
        triggered => { root.entering = false; }
    }

    layout := VerticalLayout {
        y: 0;
        height: self.min-height;
        padding-left: 14px; padding-right: 14px; padding-top: 10px; padding-bottom: 12px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            height: 16px;
            if card.has-icon: Image {
                width: 16px; height: 16px;
                source: card.icon;
            }
            if !card.has-icon: Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                background: Theme.accent;
                Text {
                    text: card.letter;
                    color: white;
                    font-size: 9px;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text {
                text: card.site;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            Text {
                horizontal-stretch: 1;
                text: card.title;
                color: Theme.text;
                font-weight: 500;
                vertical-alignment: center;
                overflow: elide;
            }
            // 숫자 자릿수가 바뀌어도 옆 글자가 흔들리지 않게 폭 고정
            if card.percent-text != "": Text {
                width: 40px;
                text: card.percent-text;
                color: Theme.percent;
                font-size: 12px;
                font-weight: 600;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
            if card.can-open: Btn {
                kind: "ghost";
                text: (Lang.en ? "Open" : "열기");
                clicked => { root.open(); }
            }
        }
        if card.show-bar: Bar {
            value: card.progress;
        }
        Text {
            text: card.status;
            color: card.tone == "error" ? Theme.danger : card.tone == "done" ? Theme.success : Theme.muted;
            font-size: 12px;
            overflow: elide;
        }
    }
}

export component DownloadPage inherits Rectangle {
    VerticalLayout {
        // 목록 머리
        HorizontalLayout {
            padding-left: 28px; padding-right: 28px; padding-top: 18px; padding-bottom: 8px;
            Text {
                text: (Lang.en ? "Downloads" : "다운로드 목록");
                color: Theme.heading;
                font-size: 15px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if Download.cards.length > 0: Btn { kind: "ghost"; text: (Lang.en ? "Clear finished" : "끝난 항목 지우기"); clicked => { Download.clear-finished(); } }
        }

        // 목록. 아래에 떠 있는 링크 칸 밑으로 지나가며 스크롤된다.
        ScrollArea {
            content-height: list.min-height;
            if Download.cards.length == 0: VerticalLayout {
                y: (parent.height - 150px) / 2 - 40px; height: 150px; width: parent.width;
                spacing: 10px;
                alignment: center;
                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 56px; height: 56px;
                        border-radius: 28px;
                        background: Theme.card-bg;
                        Image {
                            x: 16px; y: 16px; width: 24px; height: 24px;
                            source: @image-url("../assets/download.svg");
                            colorize: Theme.muted;
                        }
                    }
                }
                Text {
                    text: (Lang.en ? "No downloads yet" : "다운로드 내역 없음");
                    color: Theme.text;
                    font-size: 14px;
                    font-weight: 600;
                    horizontal-alignment: center;
                }
                Text {
                    text: (Lang.en ? "Paste a link and press Enter" : "링크를 붙여넣고 Enter");
                    color: Theme.muted;
                    font-size: 12px;
                    horizontal-alignment: center;
                }
            }
            list := VerticalLayout {
                padding-left: 28px; padding-right: 28px; padding-bottom: 130px;
                spacing: 8px;
                alignment: start;
                for card in Download.cards: Card {
                    card: card;
                    open => { Download.reveal(card.id); }
                }
            }
        }
    }
}
