// 화면 전환: 아래에 떠 있는 독. 설정 화면에서는 독이 펼쳐져 탭을 담는다.
// 무엇을 누르면 어느 화면이 되는지는 Rust(src/ui/nav.rs)가 정한다.
import { Theme, Lang } from "theme.slint";
import { Shade } from "widgets.slint";

export global Nav {
    in-out property <string> page: "download";
    in property <bool> update-dot: false;
    // 받고 있거나 기다리는 영상 수, 다 받은 영상 수. 설정 화면에서 독의 '다운로드'에 작게 보인다.
    in property <int> active-count;
    in property <int> done-count;
    in property <string> version: (Lang.en ? "Version" : "버전");
    callback go(string);
}

// 작은 숫자 동그라미. 생길 때 살짝 커졌다가 제 크기로 돌아온다.
component Count inherits Rectangle {
    in property <int> value;
    in property <color> tint;
    property <bool> popping;
    property <duration> born;
    property <float> raw: self.popping ? clamp((animation-tick() - self.born) / 320ms, 0, 1) : 1;
    // 끝에서 넘쳤다 돌아오는 곡선(back-out)
    property <float> pop: 1 + 2.70158 * pow(self.raw - 1, 3) + 1.70158 * pow(self.raw - 1, 2);
    init => {
        self.born = animation-tick();
        self.popping = true;
    }
    Timer {
        interval: 340ms;
        running: root.popping;
        triggered => { root.popping = false; }
    }
    width: 18px; height: 18px;
    Rectangle {
        x: (18px - self.width) / 2; y: (18px - self.height) / 2;
        width: 18px * root.pop; height: 18px * root.pop;
        border-radius: self.width / 2;
        background: root.tint;
    }
    Text {
        width: 18px; height: 18px;
        text: root.value > 99 ? "99" : root.value;
        color: white;
        font-size: 10px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
        opacity: clamp(root.raw * 2, 0, 1);
    }
}

component DockItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> dot;
    // 창이 좁으면 그림만 보인다
    in property <bool> labeled: true;
    // 0 보다 크면 오른쪽에 작은 동그라미로 보인다: 받는 중(빨강), 다 받음(초록)
    in property <int> active;
    in property <int> done;
    callback clicked();

    property <length> base: labeled ? 34px + label.preferred-width + 14px : 44px;
    property <length> first: root.active > 0 ? 22px : 0px;
    property <length> second: root.done > 0 ? 22px : 0px;

    height: 36px;
    width: base + first + second;
    animate width { duration: 200ms; easing: ease-out; }
    border-radius: 18px;
    background: checked ? Theme.btn-hover : touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        x: labeled ? 12px : (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
        width: 16px; height: 16px;
        source: root.icon;
        colorize: root.checked ? Theme.text : Theme.muted;
    }
    label := Text {
        x: 34px; height: parent.height;
        visible: root.labeled;
        text: root.text;
        color: root.checked ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        vertical-alignment: center;
    }
    if dot: Rectangle {
        x: parent.width - 11px; y: 6px; width: 7px; height: 7px;
        border-radius: 3.5px;
        background: Theme.accent;
    }
    if root.active > 0: Count {
        x: root.base - 8px; y: 9px;
        value: root.active;
        tint: Theme.accent;
    }
    if root.done > 0: Count {
        x: root.base - 8px + root.first; y: 9px;
        value: root.done;
        tint: Theme.success;
    }
}

component TabItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> dot;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 15px;
    background: checked ? Theme.btn-hover : touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        width: parent.width; height: parent.height;
        text: root.text;
        color: root.checked ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if dot: Rectangle {
        x: parent.width - 10px; y: 5px; width: 6px; height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
}

// 아래에 떠 있는 독. 다운로드 화면에서는 [다운로드][설정] 두 개로 작게,
// 설정 화면에서는 길게 펼쳐져 [다운로드] 옆에 설정 탭들을 담는다.
export component NavDock inherits Rectangle {
    in property <bool> labeled: true;
    // 작게 접혔을 때의 폭
    out property <length> small-width: 8px + home.width + 4px + gear.width + 8px;
    property <bool> in-settings: Nav.page != "download";
    property <float> reveal: root.in-settings ? 1 : 0;
    animate reveal { duration: 220ms; easing: ease-out; }

    height: 52px;

    Shade { radius: 26px; }
    Rectangle {
        border-radius: 26px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
        clip: true;

        home := DockItem {
            x: 8px; y: 8px;
            text: (Lang.en ? "Downloads" : "다운로드");
            icon: @image-url("../assets/download.svg");
            labeled: root.labeled;
            checked: !root.in-settings;
            // 목록이 보이지 않는 설정 화면에서만 수를 보인다
            active: root.in-settings ? Nav.active-count : 0;
            done: root.in-settings ? Nav.done-count : 0;
            clicked => { Nav.go("download"); }
        }
        gear := DockItem {
            x: 8px + home.width + 4px; y: 8px;
            text: (Lang.en ? "Settings" : "설정");
            icon: @image-url("../assets/gear.svg");
            labeled: root.labeled;
            dot: Nav.update-dot;
            opacity: 1 - root.reveal;
            visible: root.reveal < 1;
            clicked => { Nav.go("settings"); }
        }
        HorizontalLayout {
            x: 8px + home.width + 10px; y: 11px;
            width: parent.width - self.x - 18px;
            height: 30px;
            spacing: 2px;
            opacity: root.reveal;
            visible: root.reveal > 0;
            Rectangle {
                width: 9px;
                Rectangle { x: 0; y: 7px; width: 1px; height: 16px; background: Theme.border; }
            }
            TabItem { text: Lang.en ? "General" : "일반"; checked: Nav.page == "general"; clicked => { Nav.go("general"); } }
            TabItem { text: (Lang.en ? "Login" : "로그인"); checked: Nav.page == "login"; clicked => { Nav.go("login"); } }
            TabItem { text: (Lang.en ? "Network" : "네트워크"); checked: Nav.page == "network"; clicked => { Nav.go("network"); } }
            TabItem { text: (Lang.en ? "Files" : "파일"); checked: Nav.page == "file"; clicked => { Nav.go("file"); } }
            TabItem { text: (Lang.en ? "Advanced" : "고급"); checked: Nav.page == "advanced"; clicked => { Nav.go("advanced"); } }
            TabItem { text: (Lang.en ? "Update" : "업데이트"); checked: Nav.page == "update"; dot: Nav.update-dot; clicked => { Nav.go("update"); } }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: Nav.version;
                color: Theme.muted;
                font-size: 11px;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}
