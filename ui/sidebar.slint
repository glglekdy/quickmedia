// 화면 전환: 아래에 떠 있는 독(다운로드 / 설정)과 설정 화면 위의 탭.
// 무엇을 누르면 어느 화면이 되는지는 Rust(src/ui/nav.rs)가 정한다.
import { Theme } from "theme.slint";
import { Shade } from "widgets.slint";

export global Nav {
    in-out property <string> page: "download";
    in property <bool> update-dot: false;
    in property <string> version: "버전";
    callback go(string);
}

component DockItem inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> checked;
    in property <bool> dot;
    // 창이 좁으면 그림만 보인다
    in property <bool> labeled: true;
    callback clicked();

    height: 36px;
    width: labeled ? 34px + label.preferred-width + 14px : 44px;
    border-radius: 18px;
    background: checked ? Theme.btn-hover : touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        x: labeled ? 12px : (parent.width - 16px) / 2; y: (parent.height - 16px) / 2;
        width: 16px; height: 16px;
        source: root.icon;
        colorize: root.checked ? Theme.text : Theme.muted;
    }
    label := Text {
        x: 34px; height: parent.height;
        visible: root.labeled;
        text: root.text;
        color: root.checked ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        vertical-alignment: center;
    }
    if dot: Rectangle {
        x: parent.width - 11px; y: 6px; width: 7px; height: 7px;
        border-radius: 3.5px;
        background: Theme.accent;
    }
}

// 아래 오른쪽에 떠 있는 독: 다운로드 목록 / 설정
export component NavDock inherits Rectangle {
    in property <bool> labeled: true;
    property <bool> in-settings: Nav.page != "download";

    height: 52px;
    width: row.min-width;

    Shade { radius: 26px; }
    Rectangle {
        border-radius: 26px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: Theme.border;
    }
    row := HorizontalLayout {
        padding: 8px;
        spacing: 4px;
        DockItem {
            text: "다운로드";
            icon: @image-url("../assets/download.svg");
            labeled: root.labeled;
            checked: !root.in-settings;
            clicked => { Nav.go("download"); }
        }
        DockItem {
            text: "설정";
            icon: @image-url("../assets/gear.svg");
            labeled: root.labeled;
            checked: root.in-settings;
            dot: Nav.update-dot;
            clicked => { Nav.go("settings"); }
        }
    }
}

component TabItem inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> dot;
    callback clicked();

    height: 30px;
    width: label.preferred-width + 28px;
    border-radius: 15px;
    background: checked ? Theme.btn-hover : touch.has-hover ? Theme.nav-hover : transparent;
    animate background { duration: 120ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        width: parent.width; height: parent.height;
        text: root.text;
        color: root.checked ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if dot: Rectangle {
        x: parent.width - 10px; y: 5px; width: 6px; height: 6px;
        border-radius: 3px;
        background: Theme.accent;
    }
}

// 설정 화면 위의 탭 줄
export component SettingsTabs inherits Rectangle {
    height: 54px;
    HorizontalLayout {
        padding-left: 24px; padding-right: 28px; padding-top: 16px; padding-bottom: 8px;
        spacing: 2px;
        TabItem { text: "로그인"; checked: Nav.page == "login"; clicked => { Nav.go("login"); } }
        TabItem { text: "네트워크"; checked: Nav.page == "network"; clicked => { Nav.go("network"); } }
        TabItem { text: "파일"; checked: Nav.page == "file"; clicked => { Nav.go("file"); } }
        TabItem { text: "고급"; checked: Nav.page == "advanced"; clicked => { Nav.go("advanced"); } }
        TabItem { text: "업데이트"; checked: Nav.page == "update"; dot: Nav.update-dot; clicked => { Nav.go("update"); } }
        Rectangle { horizontal-stretch: 1; }
        Text {
            text: Nav.version;
            color: Theme.muted;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}
