// 아래에 떠 있는 링크 입력 칸. 평소에는 한 줄짜리 알약 모양이고,
// 누르면 위로 늘어나며 형식 · 프리셋 · 세부 옵션이 나타난다.
import { Theme } from "theme.slint";
import { Btn, LineInput, Shade, Ui } from "widgets.slint";
import { Download } from "download_state.slint";
import { OptionsPanel } from "options_panel.slint";

component SegButton inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    callback clicked();
    height: 26px;
    min-width: label.min-width + 24px;
    horizontal-stretch: 0;
    border-radius: 13px;
    background: checked ? Theme.btn-pressed : transparent;
    animate background { duration: 120ms; }
    label := Text {
        text: root.text;
        color: root.checked || touch.has-hover ? Theme.text : Theme.muted;
        font-weight: root.checked ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

// 알약 모양 단추: 프리셋, 세부 옵션
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 30px;
    min-width: row.min-width;
    horizontal-stretch: 0;
    border-radius: 15px;
    background: active ? Theme.btn-pressed : touch.has-hover ? Theme.btn-hover : Theme.btn-bg;
    animate background { duration: 120ms; }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        padding-left: 14px; padding-right: 12px;
        spacing: 6px;
        Text {
            text: root.text;
            color: root.active || touch.has-hover ? Theme.text : Theme.muted;
            font-weight: 500;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Image {
                width: 10px; height: 10px;
                source: root.active ? @image-url("../assets/arrow-down.svg") : @image-url("../assets/arrow-up.svg");
            }
        }
    }
}

// 동그란 단추: 붙여넣기, 받기
component RoundButton inherits Rectangle {
    in property <image> icon;
    in property <bool> primary;
    in property <bool> dim;
    callback clicked();
    width: 36px; height: 36px;
    border-radius: 18px;
    background: primary ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : touch.pressed ? Theme.btn-pressed : touch.has-hover ? Theme.btn-hover : Theme.btn-bg;
    opacity: dim ? 0.45 : 1;
    animate opacity { duration: 160ms; }
    animate background { duration: 120ms; }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    Image {
        x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
        width: 18px; height: 18px;
        source: root.icon;
    }
}

export component Composer inherits Rectangle {
    in-out property <bool> preset-open;
    // 설정 화면에서는 동그란 단추 하나로 줄어든다. 누르면 expand() 로 알린다.
    in property <bool> compact;
    callback expand();
    // 링크 칸을 눌렀거나 아래 줄의 무언가를 펼쳐 둔 동안 늘어나 있다
    out property <bool> open: !root.compact && (url.has-focus || Download.panel-open || root.preset-open);
    // 줄어들면 안의 것들이 사라지고 그림 하나만 남는다
    property <float> full: root.compact ? 0 : 1;
    animate full { duration: 180ms; easing: ease-out; }
    // 프리셋 메뉴가 붙을 자리(이 칸의 왼쪽에서부터)
    out property <length> preset-x: 52px + formats.width + 8px;

    // 빈 곳을 누르면 접는다
    property <int> tick: Ui.dismiss-tick;
    changed tick => { root.dismiss(); }

    public function focus-url() { url.focus-input(); }
    public function dismiss() {
        url.blur();
        root.preset-open = false;
        if Download.panel-open { Download.toggle-panel(); }
    }

    property <length> inset: root.open ? 22px : 54px;
    property <float> reveal: root.open ? 1 : 0;
    animate inset { duration: Theme.spring; easing: cubic-bezier(0.34, 1.36, 0.64, 1); }
    animate reveal { duration: 200ms; easing: ease-out; }

    height: root.open ? 98px : 52px;
    animate height { duration: Theme.spring; easing: cubic-bezier(0.34, 1.36, 0.64, 1); }

    Shade { radius: 26px; }
    Rectangle {
        border-radius: 26px;
        background: Theme.card-bg;
        border-width: 1px;
        border-color: root.open ? Theme.btn-pressed : Theme.border;
        animate border-color { duration: 200ms; }
        clip: true;

        // 알약 어디를 눌러도 링크 칸에 커서가 간다
        TouchArea {
            mouse-cursor: root.compact ? pointer : text;
            clicked => {
                if root.compact { root.expand(); } else { url.focus-input(); }
            }
        }
        // 줄어들었을 때 가운데에 남는 그림
        Image {
            x: (parent.width - 18px) / 2; y: (parent.height - 18px) / 2;
            width: 18px; height: 18px;
            source: @image-url("../assets/link.svg");
            colorize: Theme.muted;
            opacity: 1 - root.full;
            visible: root.full < 1;
        }

        url := LineInput {
            bare: true;
            opacity: root.full;
            visible: root.full > 0;
            x: root.inset;
            y: 9px;
            width: parent.width - 2 * root.inset;
            height: 34px;
            text <=> Download.url;
            placeholder: Download.url-placeholder;
            accepted => { Download.add(); }
        }

        // 아래 줄: 형식 · 프리셋 · 세부 옵션. 접혀 있을 때는 보이지 않는다.
        HorizontalLayout {
            x: 52px;
            y: parent.height - 41px;
            width: parent.width - 104px;
            height: 30px;
            spacing: 8px;
            alignment: start;
            opacity: root.reveal * root.full;
            visible: root.reveal > 0 && root.full > 0;

            formats := Rectangle {
                horizontal-stretch: 0;
                border-radius: 15px;
                background: Theme.btn-bg;
                width: seg.min-width;
                seg := HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    SegButton { text: "최고 화질"; checked: Download.preset == "best"; clicked => { Download.preset-clicked("best"); } }
                    SegButton { text: "720p"; checked: Download.preset == "720p"; clicked => { Download.preset-clicked("720p"); } }
                    SegButton { text: "MP3 음원"; checked: Download.preset == "mp3"; clicked => { Download.preset-clicked("mp3"); } }
                }
            }
            Chip {
                property <bool> chosen: Download.user-preset >= 0 && Download.user-preset < Download.user-presets.length;
                text: self.chosen ? Download.user-presets[Download.user-preset] : "프리셋";
                active: root.preset-open;
                clicked => {
                    if Download.panel-open { Download.toggle-panel(); }
                    root.preset-open = !root.preset-open;
                }
            }
            Chip {
                text: Download.more-text;
                active: Download.panel-open;
                clicked => {
                    root.preset-open = false;
                    Download.toggle-panel();
                }
            }
        }

        RoundButton {
            x: 8px; y: parent.height - 44px;
            opacity: root.full;
            visible: root.full > 0;
            icon: @image-url("../assets/paste.svg");
            clicked => { Download.paste(); }
        }
        RoundButton {
            x: parent.width - 44px; y: parent.height - 44px;
            primary: true;
            visible: root.full > 0;
            dim: Download.url == "" || root.full < 1;
            icon: @image-url("../assets/send.svg");
            clicked => { Download.add(); }
        }
    }
}

// 링크 칸 위에 뜨는 판. 안의 내용 높이에 맞춘다.
export component FloatCard inherits Rectangle {
    in property <length> content-height;
    // 보일지. 늘 만들어 두고 이 값에 따라 올라오거나 내려간다.
    in property <bool> shown;
    // 다 올라왔을 때 아래 변이 놓일 자리
    in property <length> bottom;
    property <float> rise: root.shown ? 1 : 0;
    animate rise { duration: 300ms; easing: cubic-bezier(0.34, 1.36, 0.64, 1); }

    height: content-height + 24px;
    animate height { duration: 240ms; easing: ease-out; }
    y: root.bottom - self.height + (1 - root.rise) * 22px;
    opacity: clamp(root.rise, 0, 1);
    visible: root.rise > 0.01;
    Shade { radius: 14px; }
    Rectangle {
        border-radius: 14px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.border;
    }
    // 판 위를 눌러도 뒤의 "빈 곳 누르면 접기"로 넘어가지 않게
    TouchArea { }
    @children
}

export component OptionsCard inherits FloatCard {
    content-height: panel.min-height;
    // 높이가 바뀌는 동안 내용이 판 밖으로 나가지 않게
    Rectangle {
        x: 12px; y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        clip: true;
        panel := OptionsPanel {
            y: 0;
            height: self.min-height;
        }
    }
}

// 저장해 둔 프리셋을 고르고, 지금 세부 옵션을 이름 붙여 저장한다.
export component PresetCard inherits FloatCard {
    callback picked();
    width: 280px;
    content-height: body.min-height;

    body := VerticalLayout {
        x: 12px; y: 12px;
        width: parent.width - 24px;
        height: parent.height - 24px;
        spacing: 2px;
        if Download.user-presets.length == 0: Text {
            height: 30px;
            text: "저장된 프리셋 없음";
            color: Theme.muted;
            font-size: 12px;
            vertical-alignment: center;
        }
        for name[i] in Download.user-presets: Rectangle {
            height: 30px;
            border-radius: 6px;
            background: pick.has-hover || i == Download.user-preset ? Theme.btn-hover : transparent;
            pick := TouchArea {
                clicked => {
                    Download.apply-user-preset(i);
                    root.picked();
                }
            }
            Text {
                x: 8px; width: parent.width - 44px;
                text: name;
                color: Theme.text;
                font-weight: i == Download.user-preset ? 600 : 500;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {
                x: parent.width - 28px; y: 3px;
                width: 24px; height: 24px;
                border-radius: 12px;
                background: remove.has-hover ? Theme.btn-pressed : transparent;
                Text {
                    text: "×";
                    color: remove.has-hover ? Theme.danger : Theme.muted;
                    font-size: 15px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                remove := TouchArea {
                    clicked => { Download.delete-user-preset(i); }
                }
            }
        }
        Rectangle {
            height: 13px;
            Rectangle { y: 6px; height: 1px; background: Theme.border; }
        }
        Text {
            text: "현재 옵션을 프리셋으로 저장";
            color: Theme.muted;
            font-size: 12px;
            height: 22px;
            vertical-alignment: center;
        }
        HorizontalLayout {
            spacing: 6px;
            LineInput {
                height: 30px;
                text <=> Download.preset-name;
                placeholder: "이름";
                invalid: Download.preset-error != "";
                accepted => { Download.save-preset(); }
            }
            Btn { text: "저장"; clicked => { Download.save-preset(); } }
        }
        if Download.preset-error != "": Text {
            text: Download.preset-error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}
