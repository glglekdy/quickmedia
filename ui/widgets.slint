// 화면들이 함께 쓰는 위젯. 색은 Theme 토큰만 쓴다. 테두리 없는 납작한 모양.
import { Theme } from "theme.slint";

// 보통 · 강조(primary) · 흐린(ghost) 버튼
export component Btn inherits Rectangle {
    in property <string> text;
    in property <string> kind: "normal";
    in property <bool> enabled: true;
    in property <image> icon;
    in property <bool> has-icon: false;
    callback clicked();

    property <bool> primary: kind == "primary";
    property <bool> ghost: kind == "ghost";

    height: ghost ? 26px : 30px;
    min-width: layout.min-width;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: !enabled ? (primary ? Theme.primary-disabled-bg : ghost ? transparent : Theme.disabled-bg)
        : primary ? (touch.pressed ? Theme.accent-pressed : touch.has-hover ? Theme.accent-hover : Theme.accent)
        : ghost ? (touch.has-hover ? Theme.btn-hover : transparent)
        : touch.pressed ? Theme.btn-pressed : touch.has-hover ? Theme.btn-hover : Theme.btn-bg;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    layout := HorizontalLayout {
        padding-left: primary ? 18px : ghost ? 8px : 12px;
        padding-right: primary ? 18px : ghost ? 8px : 12px;
        spacing: 6px;
        alignment: center;
        Text {
            text: root.text;
            vertical-alignment: center;
            font-weight: primary ? 600 : 500;
            color: !root.enabled ? (primary ? Theme.primary-disabled-fg : Theme.disabled-fg)
                : primary ? white
                : ghost ? (touch.has-hover ? Theme.text : Theme.muted)
                : Theme.text;
        }
        if has-icon: VerticalLayout {
            alignment: center;
            Image { width: 10px; height: 10px; source: root.icon; }
        }
    }
}

// 한 줄 입력 칸
export component LineInput inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder;
    in property <bool> read-only: false;
    in property <bool> invalid: false;
    in property <bool> enabled: true;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted();
    // 다른 곳을 눌러 칸을 떠났다
    callback left();

    public function focus-input() { input.focus(); }

    height: 34px;
    min-width: 60px;
    horizontal-stretch: 1;
    border-radius: 6px;
    border-width: 1px;
    border-color: invalid ? Theme.danger : input.has-focus && !read-only ? Theme.accent : transparent;
    background: input.has-focus && !read-only ? Theme.input-focus-bg : Theme.input-bg;

    Rectangle {
        x: 10px;
        width: parent.width - 20px;
        clip: true;

        if input.text == "" && input.preedit-text == "": Text {
            x: 0; width: parent.width;
            text: root.placeholder;
            color: Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
        input := TextInput {
            property <length> shift;
            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.shift));
            width: max(parent.width - self.text-cursor-width, self.preferred-width);
            height: parent.height;
            single-line: true;
            vertical-alignment: center;
            read-only: root.read-only;
            enabled: root.enabled;
            font-weight: 500;
            color: !root.enabled ? Theme.disabled-fg : root.read-only ? Theme.muted : Theme.text;
            selection-background-color: Theme.accent;
            selection-foreground-color: white;
            edited => { root.edited(self.text); }
            accepted => { root.accepted(); }
            changed has-focus => {
                if !self.has-focus { root.left(); }
            }
            // 글이 칸보다 길면 커서를 따라 옆으로 민다
            cursor-position-changed(pos) => {
                if pos.x + self.shift < 0px {
                    self.shift = -pos.x;
                } else if pos.x + self.shift > parent.width - self.text-cursor-width {
                    self.shift = parent.width - pos.x - self.text-cursor-width;
                }
            }
        }
    }
}

// 펼쳐 고르는 상자
export component Combo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index;
    in property <bool> enabled: true;
    callback selected(int);

    height: 30px;
    min-width: 130px;
    horizontal-stretch: 0;
    border-radius: 6px;
    border-width: 1px;
    border-color: popup-open ? Theme.accent : transparent;
    background: Theme.input-bg;

    property <bool> popup-open: false;

    Text {
        x: 10px; width: parent.width - 32px;
        text: root.current-index >= 0 && root.current-index < root.model.length ? root.model[root.current-index] : "";
        color: root.enabled ? Theme.text : Theme.disabled-fg;
        font-weight: 500;
        vertical-alignment: center;
        overflow: elide;
    }
    Image {
        x: parent.width - 18px; y: (parent.height - 10px) / 2; width: 10px; height: 10px;
        source: @image-url("../assets/arrow-down.svg");
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    popup := PopupWindow {
        x: 0;
        y: root.height + 2px;
        width: root.width;
        Rectangle {
            background: Theme.popup-bg;
            border-width: 1px;
            border-color: Theme.border;
            border-radius: 6px;
            VerticalLayout {
                padding: 4px;
                for label[i] in root.model: Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: item-touch.has-hover || i == root.current-index ? Theme.btn-hover : transparent;
                    Text {
                        x: 8px; width: parent.width - 16px;
                        text: label;
                        color: Theme.text;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    item-touch := TouchArea {
                        clicked => {
                            root.current-index = i;
                            root.selected(i);
                        }
                    }
                }
            }
        }
    }
}

// 켜고 끄는 상자
export component Check inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled(bool);

    height: 24px;
    horizontal-stretch: 0;
    min-width: row.min-width;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    row := HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px; height: 16px;
                border-radius: 4px;
                border-width: 1px;
                border-color: !root.enabled ? Theme.border : root.checked || touch.has-hover ? Theme.accent : Theme.disabled-fg;
                background: !root.enabled ? Theme.disabled-bg : root.checked ? Theme.accent : Theme.input-focus-bg;
                if root.checked: Image {
                    width: 14px; height: 14px;
                    source: @image-url("../assets/check.svg");
                }
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.disabled-fg;
            vertical-alignment: center;
        }
    }
}

// 여럿 중 하나를 고르는 둥근 단추. 선택은 밖에서 정한다.
export component Radio inherits Rectangle {
    in property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback clicked();

    height: 24px;
    horizontal-stretch: 0;
    min-width: row.min-width;

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    row := HorizontalLayout {
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px; height: 16px;
                border-radius: 8px;
                border-width: root.checked ? 5px : 1px;
                border-color: !root.enabled ? Theme.border : root.checked || touch.has-hover ? Theme.accent : Theme.disabled-fg;
                background: !root.enabled ? Theme.disabled-bg : Theme.input-focus-bg;
            }
        }
        Text {
            text: root.text;
            color: root.enabled ? Theme.text : Theme.disabled-fg;
            vertical-alignment: center;
        }
    }
}

// 진행률 막대. 값이 뚝뚝 바뀌지 않고 미끄러지듯 따라간다.
export component Bar inherits Rectangle {
    in property <float> value; // 0~1
    height: 6px;
    border-radius: 3px;
    background: Theme.track;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.value, 0, 1);
        border-radius: 3px;
        background: Theme.accent;
        animate width { duration: 300ms; easing: ease-out; }
    }
}

// 받은 만큼 왼쪽부터 채워지는 그라데이션 바탕과 아래쪽 띠. 카드나 알림 안에 깔아 쓴다.
// 부모가 `clip: true` 여야 둥근 모서리 밖으로 나가지 않는다.
export component ProgressFill inherits Rectangle {
    in property <float> value; // 0~1
    // 받는 중이면 바탕을 채우고 그 위로 빛이 지나간다. 아니면 띠만 보인다.
    in property <bool> active: true;
    property <float> sweep: root.active ? mod(animation-tick(), 1.6s) / 1.6s : 0;
    property <length> filled: self.width * clamp(root.value, 0, 1);
    animate filled { duration: 300ms; easing: ease-out; }

    if root.active: Rectangle {
        x: 0; y: 0;
        width: root.filled;
        height: parent.height;
        background: @linear-gradient(90deg, Theme.accent.transparentize(0.92) 0%, Theme.accent.transparentize(0.55) 100%);
        clip: true;
        Rectangle {
            x: (parent.width + self.width) * root.sweep - self.width;
            width: 90px;
            height: parent.height;
            background: @linear-gradient(90deg, #ffffff00 0%, #ffffff26 50%, #ffffff00 100%);
        }
    }
    Rectangle {
        x: 0; y: parent.height - self.height;
        width: root.filled;
        height: 4px;
        background: @linear-gradient(90deg, #f97316 0%, Theme.accent 55%, #fb7185 100%);
    }
}

// 세로로 스크롤되는 영역. 오른쪽에 얇은 손잡이를 보인다.
export component ScrollArea inherits Rectangle {
    in property <length> content-height;
    out property <length> visible-width: flick.width;
    vertical-stretch: 1;

    flick := Flickable {
        content-width: self.width;
        content-height: max(self.height, root.content-height);
        @children
    }
    if flick.content-height > flick.height: Rectangle {
        property <length> track: parent.height - 4px;
        property <length> handle: max(40px, track * flick.height / flick.content-height);
        x: parent.width - 7px;
        y: 2px + (track - handle) * (-flick.content-y / (flick.content-height - flick.height));
        width: 6px;
        height: handle;
        border-radius: 3px;
        background: Theme.scroll-handle;
    }
}

// 이름 | 입력 칸
export component FormRow inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 76px;
    spacing: 10px;
    VerticalLayout {
        alignment: center;
        width: root.label-width;
        Text {
            text: root.label;
            color: Theme.text;
        }
    }
    @children
}

// 숫자를 위아래 화살표로 고르는 칸
export component Spin inherits Rectangle {
    in-out property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    callback changed(int);

    function step(by: int) {
        if root.value + by >= root.minimum && root.value + by <= root.maximum {
            root.value += by;
            root.changed(root.value);
        }
    }

    width: 90px;
    height: 30px;
    horizontal-stretch: 0;
    border-radius: 6px;
    background: Theme.input-bg;

    Text {
        x: 10px; width: parent.width - 32px;
        text: root.value;
        color: Theme.text;
        font-weight: 500;
        vertical-alignment: center;
    }
    Rectangle {
        x: parent.width - 21px; y: 1px; width: 20px; height: parent.height / 2 - 1px;
        border-radius: 4px;
        background: up.has-hover ? Theme.btn-hover : transparent;
        Image { width: 9px; height: 9px; source: @image-url("../assets/arrow-up.svg"); }
        up := TouchArea { clicked => { root.step(1); } }
    }
    Rectangle {
        x: parent.width - 21px; y: parent.height / 2; width: 20px; height: parent.height / 2 - 1px;
        border-radius: 4px;
        background: down.has-hover ? Theme.btn-hover : transparent;
        Image { width: 9px; height: 9px; source: @image-url("../assets/arrow-down.svg"); }
        down := TouchArea { clicked => { root.step(-1); } }
    }
}
