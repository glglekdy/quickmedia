// 설정 화면 4개(로그인 / 네트워크 / 파일 / 고급). 바꾸면 바로 저장한다.
// 제목 + 설명 + 카드(이름 | 입력 칸, 그 아래 안내·오류) 틀.
import { Theme, Lang } from "theme.slint";
import { Btn, LineInput, Combo, Check, Radio, Spin, ScrollArea } from "widgets.slint";
import { Settings } from "settings_state.slint";
import { Download } from "download_state.slint";

// 이름 | 입력 칸 + 안내 + 오류
component Row inherits HorizontalLayout {
    in property <string> label;
    in property <length> label-width: 112px;
    in property <string> hint;
    in property <string> error;
    spacing: 12px;

    // 이름은 입력 칸 높이에 맞춰 위쪽에 둔다. 줄 높이는 오른쪽 칸(안내·오류 포함)이 정한다.
    VerticalLayout {
        width: root.label-width;
        alignment: start;
        Text {
            height: 30px;
            text: root.label;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
    VerticalLayout {
        spacing: 4px;
        alignment: start;
        @children
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

// 고르는 단추가 이름 자리에 오는 줄(로그인 화면)
component RadioRow inherits HorizontalLayout {
    in property <string> text;
    in property <bool> checked;
    in property <string> hint;
    in property <string> error;
    callback clicked();
    spacing: 12px;

    VerticalLayout {
        width: 160px;
        alignment: start;
        HorizontalLayout {
            height: 30px;
            alignment: start;
            Radio { text: root.text; checked: root.checked; clicked => { root.clicked(); } }
        }
    }
    VerticalLayout {
        spacing: 4px;
        alignment: start;
        @children
        if root.hint != "": Text {
            text: root.hint;
            color: Theme.muted;
            font-size: 12px;
            wrap: word-wrap;
        }
        if root.error != "": Text {
            text: root.error;
            color: Theme.danger;
            font-size: 12px;
            wrap: word-wrap;
        }
    }
}

export component SettingsPage inherits Rectangle {
    // general, login, network, file, advanced
    in property <string> page;

    property <string> title: page == "general" ? (Lang.en ? "General" : "일반") : page == "login" ? (Lang.en ? "Login" : "로그인") : page == "network" ? (Lang.en ? "Network" : "네트워크") : page == "file" ? (Lang.en ? "Files" : "파일") : (Lang.en ? "Advanced" : "고급");

    ScrollArea {
        content-height: body.min-height;
        body := VerticalLayout {
            padding-left: 28px; padding-right: 28px; padding-top: 24px; padding-bottom: 24px;
            alignment: start;

            HorizontalLayout {
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.title;
                    color: Theme.heading;
                    font-size: 22px;
                    font-weight: 600;
                }
                if Settings.saved-badge: HorizontalLayout {
                    spacing: 3px;
                    VerticalLayout {
                        alignment: center;
                        Image {
                            width: 12px; height: 12px;
                            source: @image-url("../assets/check.svg");
                            colorize: Theme.success;
                        }
                    }
                    Text {
                        text: (Lang.en ? "Saved" : "저장됨");
                        color: Theme.success;
                        font-size: 12px;
                        vertical-alignment: center;
                    }
                }
            }
            Rectangle { height: 16px; }

            Rectangle {
                background: Theme.card-bg;
                border-width: 1px;
                border-color: Theme.border;
                border-radius: 10px;

                VerticalLayout {
                    padding-left: 20px; padding-right: 20px; padding-top: 18px; padding-bottom: 18px;
                    spacing: 14px;

                    // ---------- 로그인 ----------
                    if page == "login": RadioRow {
                        text: (Lang.en ? "Off" : "사용 안 함");
                        checked: Settings.cookies == 0;
                        clicked => { Settings.cookies = 0; Settings.commit("cookies"); }
                    }
                    if page == "login": RadioRow {
                        text: (Lang.en ? "From a browser" : "브라우저에서 가져오기");
                        checked: Settings.cookies == 1;
                        hint: (Lang.en ? "Chrome and Edge may block cookie access while running" : "Chrome·Edge는 실행 중이면 쿠키를 읽지 못할 수 있음");
                        clicked => { Settings.cookies = 1; Settings.commit("cookies"); }
                        HorizontalLayout {
                            alignment: start;
                            Combo {
                                model: ["Firefox", "Edge", "Chrome", "Whale", "Brave", "Opera", "Vivaldi", "Chromium"];
                                enabled: Settings.cookies == 1;
                                current-index <=> Settings.cookie-browser;
                                selected => { Settings.commit("cookies"); }
                            }
                        }
                    }
                    if page == "login": RadioRow {
                        text: (Lang.en ? "cookies.txt file" : "cookies.txt 파일");
                        checked: Settings.cookies == 2;
                        error: Settings.error-cookie-file;
                        clicked => { Settings.cookies = 2; Settings.commit("cookies"); }
                        HorizontalLayout {
                            spacing: 6px;
                            max-width: 400px;
                            LineInput {
                                height: 30px;
                                placeholder: (Lang.en ? "Choose a file" : "파일 선택");
                                enabled: Settings.cookies == 2;
                                invalid: Settings.error-cookie-file != "";
                                text <=> Settings.cookie-file;
                                accepted => { Settings.commit("cookies"); }
                                left => { Settings.commit("cookies"); }
                            }
                            Btn {
                                text: (Lang.en ? "Browse" : "찾기");
                                enabled: Settings.cookies == 2;
                                clicked => { Settings.browse-cookie(); }
                            }
                        }
                    }

                    // ---------- 네트워크 ----------
                    if page == "network": Row {
                        label: (Lang.en ? "Proxy" : "프록시");
                        LineInput {
                            height: 30px;
                            max-width: 400px;
                            placeholder: "http://127.0.0.1:8080";
                            text <=> Settings.proxy;
                            accepted => { Settings.commit("proxy"); }
                            left => { Settings.commit("proxy"); }
                        }
                    }
                    if page == "network": Row {
                        label: (Lang.en ? "Speed limit" : "속도 제한");
                        hint: (Lang.en ? "Empty means no limit. 5M = 5 MB/s" : "비우면 제한 없음. 5M = 초당 5MB");
                        error: Settings.error-rate-limit;
                        HorizontalLayout {
                            alignment: start;
                            LineInput {
                                width: 160px; height: 30px;
                                placeholder: (Lang.en ? "e.g. 5M" : "예: 5M");
                                invalid: Settings.error-rate-limit != "";
                                text <=> Settings.rate-limit;
                                accepted => { Settings.commit("rate_limit"); }
                                left => { Settings.commit("rate_limit"); }
                            }
                        }
                    }
                    if page == "network": Row {
                        label: (Lang.en ? "Retries" : "재시도 횟수");
                        HorizontalLayout {
                            alignment: start;
                            Spin {
                                minimum: 0; maximum: 50;
                                value <=> Settings.retries;
                                changed => { Settings.commit("retries"); }
                            }
                        }
                    }
                    if page == "network": Row {
                        label: (Lang.en ? "Parallel" : "동시 다운로드");
                        hint: (Lang.en ? "Videos downloaded at once (1–5)" : "동시에 받는 영상 수 (1~5)");
                        HorizontalLayout {
                            alignment: start;
                            Spin {
                                minimum: 1; maximum: 5;
                                value <=> Settings.concurrency;
                                changed => { Settings.commit("concurrency"); }
                            }
                        }
                    }

                    // ---------- 파일 ----------
                    if page == "file": Row {
                        label: (Lang.en ? "Save to" : "저장 위치");
                        HorizontalLayout {
                            spacing: 6px;
                            LineInput {
                                height: 30px;
                                text: Download.folder;
                                read-only: true;
                            }
                            Btn { text: (Lang.en ? "Change" : "변경"); clicked => { Download.pick-folder(); } }
                            Btn { text: (Lang.en ? "Open folder" : "폴더 열기"); clicked => { Download.open-folder(); } }
                        }
                    }
                    if page == "file": Row {
                        label: (Lang.en ? "File name" : "파일 이름");
                        HorizontalLayout {
                            alignment: start;
                            Combo {
                                width: 170px;
                                model: [(Lang.en ? "Title" : "제목"), (Lang.en ? "Title [ID]" : "제목 [ID]"), (Lang.en ? "Uploader - Title" : "업로더 - 제목"), (Lang.en ? "Date Title" : "날짜 제목"), (Lang.en ? "Custom" : "직접 입력")];
                                current-index <=> Settings.name-template;
                                selected => { Settings.commit("template"); }
                            }
                        }
                    }
                    if page == "file": Row {
                        label: (Lang.en ? "Custom" : "직접 입력");
                        hint: (Lang.en ? "yt-dlp output template syntax" : "yt-dlp 출력 템플릿 문법");
                        error: Settings.error-custom-template;
                        LineInput {
                            height: 30px;
                            max-width: 400px;
                            enabled: Settings.name-template == 4;
                            invalid: Settings.error-custom-template != "";
                            text <=> Settings.custom-template;
                            accepted => { Settings.commit("template"); }
                            left => { Settings.commit("template"); }
                        }
                    }
                    if page == "file": Row {
                        label: "";
                        hint: (Lang.en ? "When off, saves with a number, like 'Title (1).mp4'" : "끄면 '제목 (1).mp4'처럼 번호를 붙여 저장");
                        HorizontalLayout {
                            alignment: start;
                            Check {
                                text: (Lang.en ? "Overwrite files with the same name" : "같은 이름의 파일이 있으면 덮어쓰기");
                                checked <=> Settings.overwrite;
                                toggled => { Settings.commit("overwrite"); }
                            }
                        }
                    }

                    // ---------- 고급 ----------
                    if page == "general": Row {
                        label: Lang.en ? "Language" : "언어";
                        HorizontalLayout {
                            alignment: start;
                            Combo {
                                width: 170px;
                                model: ["한국어", "English"];
                                current-index <=> Settings.language;
                                selected => { Settings.set-language(Settings.language); }
                            }
                        }
                    }
                    if page == "advanced": Row {
                        label: (Lang.en ? "yt-dlp options" : "yt-dlp 옵션");
                        error: Settings.error-extra-args;
                        LineInput {
                            height: 30px;
                            max-width: 400px;
                            placeholder: (Lang.en ? "e.g. --limit-rate 1M --no-mtime" : "예: --limit-rate 1M --no-mtime");
                            invalid: Settings.error-extra-args != "";
                            text <=> Settings.extra-args;
                            accepted => { Settings.commit("extra_args"); }
                            left => { Settings.commit("extra_args"); }
                        }
                    }
                }
            }
        }
    }
}
