// 색 토큰. 무채색 회색 단계 + 빨강 강조색. OS 라이트/다크 설정을 따르고, 바꾸면 바로 따라간다.
import { Palette } from "std-widgets.slint";
// LINE Seed Sans KR (SIL Open Font License 1.1). exe 에 넣어 어느 PC 에서나 같은 글꼴로 보인다.
import "../assets/fonts/LINESeedKR-Rg.ttf";
import "../assets/fonts/LINESeedKR-Bd.ttf";

export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #141414 : #f5f5f5;
    out property <color> surface: dark ? #1c1c1c : #ffffff;
    out property <color> border: dark ? #2e2e2e : #e5e5e5;
    out property <color> text: dark ? #e6e6e6 : #1f1f1f;
    out property <color> heading: dark ? #f0f0f0 : #141414;
    out property <color> muted: dark ? #8c8c8c : #737373;
    out property <color> btn-bg: dark ? #2c2c2c : #ebebeb;
    out property <color> btn-hover: dark ? #333333 : #e0e0e0;
    out property <color> btn-pressed: dark ? #3a3a3a : #d6d6d6;
    out property <color> disabled-fg: dark ? #5c5c5c : #a3a3a3;
    out property <color> disabled-bg: dark ? #1f1f1f : #f0f0f0;
    out property <color> primary-disabled-bg: dark ? #5c2626 : #fecaca;
    out property <color> primary-disabled-fg: dark ? #8c8c8c : #ffffff;
    out property <color> input-bg: dark ? #2c2c2c : #ebebeb;
    out property <color> input-focus-bg: dark ? #2c2c2c : #ffffff;
    out property <color> popup-bg: dark ? #232323 : #ffffff;
    out property <color> card-bg: dark ? #232323 : #ffffff;
    out property <color> track: dark ? #2c2c2c : #e5e5e5;
    out property <color> percent: dark ? #f87171 : #b91c1c;
    out property <color> accent: #dc2626;
    out property <color> accent-hover: #e54343;
    out property <color> accent-pressed: #c41f1f;
    out property <color> danger: dark ? #ef4444 : #dc2626;
    out property <color> success: dark ? #22c55e : #16a34a;
    out property <color> scroll-handle: dark ? #2c2c2c : #d4d4d4;
    out property <color> nav-hover: dark ? #232323 : #f0f0f0;
    out property <length> font-size: 13px;
    out property <string> font: "LINE Seed Sans KR";
}
