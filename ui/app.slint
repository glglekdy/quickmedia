// 메인 창: 화면(다운로드 목록 · 설정 탭들) 위로, 아래에 링크 칸과 독이 떠 있다.
import { Theme } from "theme.slint";
import { Ui } from "widgets.slint";
import { NavDock, Nav } from "sidebar.slint";
import { Download, CardView } from "download_state.slint";
import { DownloadPage } from "download.slint";
import { Settings } from "settings_state.slint";
import { SettingsPage } from "settings.slint";
import { Update, NoteLineView } from "update_state.slint";
import { UpdatePage } from "update.slint";
import { ToolDock, Glow } from "toast.slint";
import { Composer, OptionsCard, PresetCard } from "composer.slint";

export { Theme, Nav, Download, CardView, Settings, Update, NoteLineView }

// 설정 쪽 화면 하나
component TabView inherits Rectangle {
    in property <string> key;
    if root.key != "update": SettingsPage { page: root.key; }
    if root.key == "update": UpdatePage { }
}

export component AppWindow inherits Window {
    title: "QuickMedia";
    icon: @image-url("../assets/icon.png");
    preferred-width: 920px;
    preferred-height: 640px;
    min-width: 690px;
    min-height: 480px;
    background: Theme.bg;
    default-font-family: Theme.font;
    default-font-size: Theme.font-size;

    // 링크 칸에 커서를 둔다
    public function focus-url() { composer.focus-url(); }
    // 링크 칸을 접는다
    public function dismiss-composer() { composer.dismiss(); }
    // 받기 버튼에서 동그라미가 나와 새 카드 자리로 날아가 펼쳐진다
    public function launch-card() {
        if !root.in-settings {
            root.fly-from = animation-tick();
            root.flying = true;
        }
    }

    property <bool> in-settings: Nav.page != "download";
    // 아래에 떠 있는 것들이 차지하는 높이. 설정 화면은 이만큼 위에서 끝난다.
    property <length> floor: 84px;
    property <length> side: 28px;
    // 0: 다운로드 화면(링크 칸이 넓다) → 1: 설정 화면(링크 칸이 동그랗게 줄고 독이 펼쳐진다).
    // 끝에서 살짝 넘쳤다 돌아와 쫀득하게 움직인다. 둘의 폭을 같은 값으로 정해 사이 틈은 늘 같다.
    property <float> shift: root.in-settings ? 1 : 0;
    animate shift { duration: Theme.spring; easing: cubic-bezier(0.34, 1.36, 0.64, 1); }
    property <length> strip: root.width - 2 * root.side - 10px;
    property <length> composer-wide: root.strip - dock.small-width;

    // ---------- 화면 전환 ----------
    // 새 화면은 가는 쪽에서 밀려 들어오며 나타나고, 보던 화면은 반대쪽으로 밀려 나가며 흐려진다.
    // 움직이는 동안에만 시계를 본다(끝나면 다시 그리지 않는다).
    property <string> page: Nav.page;
    property <string> shown: "download";
    property <string> leaving: "download";
    property <bool> moving;
    property <duration> move-from;
    property <float> direction: 1;
    property <float> move-raw: root.moving ? clamp((animation-tick() - root.move-from) / 300ms, 0, 1) : 1;
    // 처음에 빠르고 끝에서 느려진다
    property <float> move: 1 - pow(1 - root.move-raw, 3);
    property <length> slide: 56px;

    pure function order(key: string) -> int {
        key == "download" ? 0 : key == "login" ? 1 : key == "network" ? 2 : key == "file" ? 3 : key == "advanced" ? 4 : 5
    }
    changed page => {
        if root.page != root.shown {
            root.leaving = root.shown;
            root.shown = root.page;
            root.direction = order(root.shown) >= order(root.leaving) ? 1 : -1;
            root.move-from = animation-tick();
            root.moving = true;
        }
    }
    Timer {
        interval: 320ms;
        running: root.moving;
        triggered => { root.moving = false; }
    }

    // 받기 버튼에서 날아가는 동그라미
    property <bool> flying;
    property <duration> fly-from;
    property <float> fly-raw: root.flying ? clamp((animation-tick() - root.fly-from) / 520ms, 0, 1) : 1;
    property <float> fly: 1 - pow(1 - root.fly-raw, 3);
    Timer {
        interval: 540ms;
        running: root.flying;
        triggered => { root.flying = false; }
    }

    // 빈 곳을 누르면 링크 칸을 접는다
    TouchArea {
        clicked => { Ui.dismiss-tick += 1; }
    }

    // ---------- 화면 ----------
    DownloadPage {
        property <bool> here: root.shown == "download";
        property <bool> going: root.moving && root.leaving == "download";
        visible: self.here || self.going;
        x: self.here ? root.direction * root.slide * (1 - root.move) : -root.direction * root.slide * root.move;
        y: 0;
        width: parent.width;
        height: parent.height;
        opacity: self.here ? root.move : 1 - root.move;
    }
    if root.shown != "download": TabView {
        key: root.shown;
        x: root.direction * root.slide * (1 - root.move);
        y: 0;
        width: parent.width;
        height: parent.height - root.floor;
        opacity: root.move;
    }
    if root.moving && root.leaving != "download": TabView {
        key: root.leaving;
        x: -root.direction * root.slide * root.move;
        y: 0;
        width: parent.width;
        height: parent.height - root.floor;
        opacity: 1 - root.move;
    }

    // ---------- 아래에 떠 있는 것들 ----------
    Glow {
        x: 0;
        y: parent.height - self.height;
        width: parent.width;
        active: Download.glow;
    }

    OptionsCard {
        shown: Download.panel-open;
        bottom: composer.y - 10px;
        x: root.side;
        width: parent.width - 2 * root.side;
    }
    PresetCard {
        shown: composer.preset-open;
        bottom: composer.y - 10px;
        x: min(composer.x + composer.preset-x, parent.width - self.width - root.side);
        picked => { composer.preset-open = false; }
    }
    if Download.error != "" && !root.in-settings && !Download.panel-open && !composer.preset-open: Rectangle {
        x: composer.x + 20px;
        y: composer.y - self.height - 8px;
        width: min(message.preferred-width + 24px, composer.width - 40px);
        height: 28px;
        border-radius: 14px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.danger.transparentize(0.5);
        message := Text {
            x: 12px; width: parent.width - 24px; height: parent.height;
            text: Download.error;
            color: Theme.danger;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    if Download.tool-text != "" && !Download.panel-open && !composer.preset-open: ToolDock {
        // 설정 화면에서는 링크 칸이 동그랗게 줄어 있으니 그 폭을 따르지 않는다
        x: root.side;
        width: root.in-settings ? root.width - 2 * root.side : root.composer-wide;
        y: composer.y - self.height - 12px;
    }

    composer := Composer {
        x: root.side;
        y: parent.height - self.height - 16px;
        width: root.composer-wide + (52px - root.composer-wide) * root.shift;
        compact: root.in-settings;
        expand => {
            Nav.go("download");
            self.focus-url();
        }
    }
    // 받기 버튼 자리에서 나와 목록 맨 위 카드 자리로 가며 카드 모양으로 펼쳐지고, 끝에서 흐려진다
    if root.flying: Rectangle {
        property <length> from-x: composer.x + composer.width - 44px;
        property <length> from-y: root.height - 16px - 44px;
        property <length> to-x: root.side;
        property <length> to-y: 52px;
        property <length> to-w: root.width - 2 * root.side;
        property <length> to-h: 92px;
        x: self.from-x + (self.to-x - self.from-x) * root.fly;
        y: self.from-y + (self.to-y - self.from-y) * root.fly;
        width: 36px + (self.to-w - 36px) * root.fly;
        height: 36px + (self.to-h - 36px) * root.fly;
        border-radius: 18px + (10px - 18px) * root.fly;
        background: Theme.accent.mix(Theme.card-bg, 1 - root.fly);
        border-width: 1px;
        border-color: Theme.accent.mix(Theme.border, 1 - root.fly);
        opacity: root.fly-raw < 0.6 ? 1 : 1 - (root.fly-raw - 0.6) / 0.4;
    }

    dock := NavDock {
        x: parent.width - self.width - root.side;
        y: parent.height - self.height - 16px;
        width: root.strip - composer.width;
        labeled: root.width >= 820px;
    }
}
